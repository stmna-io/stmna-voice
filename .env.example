# STMNA Voice — Environment Variables Example
# Copy this file to .env and fill in your values.
# Never commit your .env file to git.

# ── Inference (STMNA Desk) ────────────────────────────────────────────────────

# URL of your llama-swap instance (Qwen3-4B-Voice must be registered)
LLAMA_SWAP_URL=http://10.0.10.54:8081

# URL of the dedicated whisper-voice container
WHISPER_VOICE_URL=http://whisper-voice:8083

# Whisper model name (must match filename in models dir)
WHISPER_MODEL=large-v3-turbo-q5_0.bin

# Qwen model name in llama-swap (always-on persistent group)
QWEN_VOICE_MODEL=qwen3-4b-voice

# ── n8n ──────────────────────────────────────────────────────────────────────

# n8n encryption key (generate: openssl rand -hex 32)
N8N_ENCRYPTION_KEY=

# n8n port
N8N_PORT=5678

# ── PostgreSQL ────────────────────────────────────────────────────────────────

POSTGRES_USER=voice
POSTGRES_PASSWORD=
POSTGRES_DB=stmna_signal
POSTGRES_HOST=postgres-voice
POSTGRES_PORT=5432

# ── Caddy / Public Endpoint ───────────────────────────────────────────────────

# Your public domain (Caddy handles HTTPS on VPS)
PUBLIC_DOMAIN=yourdomain.com

# Subdomain for Voice endpoint (e.g. stv.yourdomain.com)
VOICE_SUBDOMAIN=stv

# Bearer token for API auth (generate: openssl rand -hex 32)
CADDY_BEARER_TOKEN=

# ── Paths ────────────────────────────────────────────────────────────────────

# Host path to model files
MODELS_DIR=/home/stmna/models

# Host path to persistent data
DATA_DIR=/home/stmna/data
