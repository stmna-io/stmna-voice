# STMNA_Voice Pipeline: Environment Variables
# ==============================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# === Whisper STT ===
# URL of your whisper-server (whisper.cpp server or compatible)
WHISPER_URL=http://your-whisper:8083

# === LLM Inference ===
LLAMA_SWAP_URL=http://your-llama-swap:8081

# Model used for voice note cleanup/summarization
VOICE_MODEL=qwen3-4b-voice

# === PostgreSQL Database ===
POSTGRES_HOST=your-postgres-host
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-password
POSTGRES_DB_VOICE=stmna_voice

# === External Endpoint (optional) ===
# Public domain for receiving voice webhook POSTs
VOICE_DOMAIN=YOURDOMAIN.COM

# Bearer token for authenticating incoming webhook requests
VOICE_BEARER_TOKEN=your-bearer-token

# === n8n Settings ===
# Required for Code nodes that use filesystem and child_process
NODE_FUNCTION_ALLOW_BUILTIN=fs,child_process,path
